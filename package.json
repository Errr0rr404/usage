{
  "name": "usage",
  "productName": "Usage",
  "version": "0.2.0",
  "license": "MIT",
  "author": "Errr0rr404",
  "repository": {
    "type": "git",
    "url": "https://github.com/Errr0rr404/usage.git"
  },
  "description": "Floating desktop meter for Grok, MiniMax, Codex, and Claude usage.",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test lib/parse.test.cjs lib/login-capture.test.cjs lib/oauth.test.cjs",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac dmg zip --arm64 --x64 --publish never",
    "dist:win": "electron-builder --win nsis --x64 --ia32 --publish never"
  },
  "build": {
    "appId": "app.usage.desktop",
    "productName": "Usage",
    "directories": {
      "output": "dist"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "electron/**/*",
      "lib/**/*",
      "renderer/**/*",
      "build/icon.png",
      "build/icon.ico",
      "package.json",
      "!lib/**/*.test.cjs"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "buildUniversalInstaller": false
    }
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron@35.7.5": true,
    "electron-winstaller@5.4.0": true
  }
}
